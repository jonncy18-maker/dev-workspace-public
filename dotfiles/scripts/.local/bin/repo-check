#!/usr/bin/env bash
# Checks every repo in ~/code for unsaved (uncommitted) work and unpushed commits.
# Sends a desktop notification only if something needs attention. Log: ~/.local/state/repo-check.log
LOG=~/.local/state/repo-check.log
issues=""
for d in ~/code/*/; do
  [ -d "$d/.git" ] || continue
  name=$(basename "$d")
  dirty=$(git -C "$d" status --porcelain | wc -l)
  ahead=$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  [ "$dirty" -gt 0 ] && issues+="$name: $dirty uncommitted"$'\n'
  [ "$ahead" -gt 0 ] && issues+="$name: $ahead unpushed"$'\n'
done
{ date '+%F %T'; echo "${issues:-all clean}"; } >> "$LOG"
[ -n "$issues" ] && notify-send -a "Repo check" "Repos need attention" "$issues"
exit 0
